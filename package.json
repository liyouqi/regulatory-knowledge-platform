{
  "name": "regulatory-knowledge-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail npm:dev:server npm:dev:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "source:list": "node --import tsx src/ingestion/cli.ts list",
    "source:fetch": "node --import tsx src/ingestion/cli.ts fetch",
    "source:verify": "node --import tsx src/ingestion/cli.ts verify",
    "canonical:build": "node --import tsx src/ingestion/canonical-cli.ts",
    "canonical:inspect": "node --import tsx src/ingestion/canonical-cli.ts --inspect",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.0",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}

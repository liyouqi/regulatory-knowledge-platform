{
  "name": "regulatory-knowledge-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "npm run runtime:build",
    "dev": "concurrently --kill-others-on-fail npm:dev:server npm:dev:web",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run runtime:build",
    "start": "node --import tsx src/server/index.ts",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "source:list": "node --import tsx src/ingestion/cli.ts list",
    "source:fetch": "node --import tsx src/ingestion/cli.ts fetch",
    "source:verify": "node --import tsx src/ingestion/cli.ts verify",
    "cssf:source:list": "node --import tsx src/ingestion/cssf-cli.ts list",
    "cssf:source:fetch": "node --import tsx src/ingestion/cssf-cli.ts fetch",
    "cssf:source:verify": "node --import tsx src/ingestion/cssf-cli.ts verify",
    "cssf:canonical:build": "node --import tsx src/ingestion/cssf-canonical-cli.ts",
    "cssf:canonical:inspect": "node --import tsx src/ingestion/cssf-canonical-cli.ts --inspect",
    "canonical:build": "node --import tsx src/ingestion/canonical-cli.ts",
    "canonical:inspect": "node --import tsx src/ingestion/canonical-cli.ts --inspect",
    "runtime:build": "node --import tsx src/search/build-search-index.ts",
    "runtime:verify": "node --import tsx src/runtime/verify-runtime-artifact.ts",
    "release:verify": "npm run runtime:build && node --import tsx src/release/verify-corpus.ts",
    "relationships:benchmark": "node --import tsx src/relationships/benchmark-related-recitals.ts",
    "search:benchmark": "node --import tsx src/search/benchmark-search.ts",
    "performance:benchmark": "npm run runtime:build && npm run build && node --import tsx src/performance/benchmark-reader.ts",
    "pretest": "npm run runtime:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.0",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
